.page {
  padding: 20rpx 24rpx 160rpx;
}

.addr-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: opacity 0.2s ease;
}

.addr-ico {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.addr-info {
  flex: 1;
}

.addr-line {
  display: flex;
  align-items: baseline;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.addr-phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.addr-empty {
  font-size: 28rpx;
  color: #999999;
}

.addr-arrow {
  color: #cccccc;
  font-size: 40rpx;
}

.goods-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.goods-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.thumb {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods-title {
  font-size: 27rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-price {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.price {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: 600;
}

.count {
  color: #999999;
  font-size: 24rpx;
}

.summary {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #333333;
  border-bottom: 1rpx solid #f5f5f5;
}

.summary-row:last-child {
  border-bottom: none;
}

.value {
  color: #666666;
}

.value.free {
  color: #ff5000;
}

/* 优惠券行 */
.coupon-row .value.on {
  color: #ff5000;
}

.coupon-value {
  display: flex;
  align-items: center;
}

.coupon-row .arrow {
  margin-left: 8rpx;
  color: #cccccc;
  font-size: 32rpx;
}

.coupon-tip {
  font-size: 22rpx;
  color: #ff5000;
  margin-bottom: 4rpx;
}

.remark-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.remark-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.remark-input {
  font-size: 26rpx;
  color: #333333;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.total {
  flex: 1;
}

.total-label {
  font-size: 26rpx;
  color: #333333;
}

.total-price {
  color: #ff5000;
  font-size: 40rpx;
  font-weight: 600;
}

.submit-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 64rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.submit-btn.disabled {
  opacity: 0.5;
}
