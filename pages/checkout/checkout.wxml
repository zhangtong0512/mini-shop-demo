<view class="page" wx:if="{{items.length > 0}}">
  <!-- 配送方式选择 -->
  <view class="delivery-mode-card">
    <view class="mode-option {{deliveryMode === 'express' ? 'active' : ''}}" bindtap="onDeliveryModeTap" data-mode="express">
      <text class="mode-icon">🚚</text>
      <text class="mode-text">快递配送</text>
    </view>
    <view class="mode-option {{deliveryMode === 'selfPickup' ? 'active' : ''}}" bindtap="onDeliveryModeTap" data-mode="selfPickup">
      <text class="mode-icon">🏪</text>
      <text class="mode-text">门店自提</text>
    </view>
  </view>

  <!-- 收货地址（快递配送时显示） -->
  <view class="addr-card" hover-class="hv" bindtap="onAddressTap" wx:if="{{deliveryMode === 'express'}}">
    <block wx:if="{{address}}">
      <view class="addr-ico">📍</view>
      <view class="addr-info">
        <view class="addr-line">
          <text class="addr-name">{{address.name}}</text>
          <text class="addr-phone">{{address.phone}}</text>
        </view>
        <view class="addr-detail">{{address.regionText}} {{address.detail}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="addr-ico">📍</view>
      <view class="addr-info">
        <view class="addr-empty">请选择收货地址</view>
      </view>
    </block>
    <view class="addr-arrow">›</view>
  </view>

  <!-- 门店选择（自提时显示） -->
  <view class="store-card" hover-class="hv" bindtap="onStoreTap" wx:if="{{deliveryMode === 'selfPickup'}}">
    <block wx:if="{{currentStore}}">
      <view class="addr-ico">🏪</view>
      <view class="addr-info">
        <view class="addr-line">
          <text class="addr-name">{{currentStore.name}}</text>
        </view>
        <view class="addr-detail">{{currentStore.address}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="addr-ico">🏪</view>
      <view class="addr-info">
        <view class="addr-empty">请选择自提门店</view>
      </view>
    </block>
    <view class="addr-arrow">›</view>
  </view>

  <!-- 商品清单 -->
  <view class="goods-card">
    <view class="goods-header">商品清单</view>
    <view class="goods-item" wx:for="{{items}}" wx:key="index">
      <view class="thumb">
        <text class="thumb-emoji">{{item.emoji}}</text>
        <image class="thumb-img" src="{{item.image}}" mode="aspectFill" />
      </view>
      <view class="goods-info">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-spec" wx:if="{{item.spec}}">{{item.spec}}</view>
        <view class="goods-price">
          <text class="price">¥{{item.price}}</text>
          <text class="count">x{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="summary">
    <view class="summary-row">
      <text>商品金额</text>
      <text class="value">¥{{goodsAmount}}</text>
    </view>
    <view class="summary-row">
      <text>运费</text>
      <text class="value {{freight == 0 ? 'free' : ''}}">{{freight == 0 ? '免运费' : '¥' + freight}}</text>
    </view>
    <view class="summary-row coupon-row" hover-class="hv" bindtap="onCouponTap">
      <text>优惠券</text>
      <view class="coupon-value">
        <text class="value {{couponId ? 'on' : ''}}">{{couponId ? '-¥' + couponAmount : (usableCoupons.length ? usableCoupons.length + ' 张可用' : '暂无可用')}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="summary-row coupon-row" hover-class="hv" bindtap="onPointsTap">
      <text>积分抵扣</text>
      <view class="coupon-value">
        <text class="value {{usePoints ? 'on' : ''}} {{pointsCanUse ? '' : 'muted'}}">{{usePoints ? '-¥' + pointsAmount : (pointsCanUse ? '可用 ' + pointsUsable + ' 积分' : '不足100积分')}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="summary-row" wx:if="{{memberDiscount < 1}}">
      <text>会员折扣 ({{memberLevelName}})</text>
      <text class="value on">-¥{{memberDiscountAmount}}</text>
    </view>
    <view class="summary-row">
      <text>配送方式</text>
      <text class="value">{{deliveryMode === 'express' ? '普通快递 · 满' + freeShippingThreshold + '元包邮' : '门店自提 · 免运费'}}</text>
    </view>
    <view class="summary-row">
      <text>支付方式</text>
      <text class="value">在线支付</text>
    </view>
  </view>

  <!-- 订单备注 -->
  <view class="remark-card">
    <view class="remark-label">订单备注</view>
    <input class="remark-input" placeholder="选填，给卖家留言（限 50 字）" value="{{remark}}" bindinput="onRemark" maxlength="50" />
  </view>

  <view class="footer">
    <view class="total">
      <view class="coupon-tip" wx:if="{{couponAmount + pointsAmount + memberDiscountAmount > 0}}">已优惠 ¥{{couponAmount + pointsAmount + memberDiscountAmount}}</view>
      <view class="total-line">
        <text class="total-label">应付：</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" hover-class="{{submitting ? '' : 'hv-btn'}}" bindtap="onSubmit">提交订单</view>
  </view>

  <!-- 自定义支付底部弹层（模拟支付 / 真实支付失败兜底） -->
  <pay-sheet id="paySheet" />
</view>
