.page {
  padding: 20rpx 24rpx 60rpx;
}

/* 顶部 tab */
.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
}

.tab.active {
  background: #fff1ea;
  color: #ff5000;
  font-weight: 600;
}

/* 优惠券卡片 */
.coupon-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.c-left {
  width: 200rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  text-align: center;
  padding: 32rpx 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.c-amount {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.c-amount .yen {
  font-size: 28rpx;
  font-weight: 400;
  margin-right: 4rpx;
}

.c-cond {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.c-right {
  flex: 1;
  min-width: 0;
  padding: 28rpx 20rpx;
}

.c-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.c-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.c-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

/* 右侧领取按钮 / 状态 */
.c-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 10rpx 28rpx;
  background: linear-gradient(90deg, #ff5500, #ff3200);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 28rpx;
}

.c-btn.claimed {
  background: #eeeeee;
  color: #999999;
}

.c-status {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 我的券：已过期置灰 */
.coupon-card.disabled .c-left {
  background: linear-gradient(135deg, #cfcfcf, #aaaaaa);
}

.coupon-card.disabled {
  opacity: 0.85;
}

/* 选择模式下「不使用优惠券」 */
.none {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
  color: #999999;
  font-size: 27rpx;
}

.page-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999999;
}
