.order-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.address-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.address-info {
  flex: 1;
}

.address-user {
  margin-bottom: 10rpx;
}

.address-name {
  font-size: 32rpx;
  color: #333;
  margin-right: 20rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #999;
}

.address-empty {
  flex: 1;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.address-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

.goods-card {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.goods-image-wrap {
  width: 160rpx;
  height: 160rpx;
  margin-right: 24rpx;
}

.goods-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price-row {
  margin-top: 16rpx;
}

.goods-price {
  font-size: 36rpx;
  color: #ff5000;
  font-weight: bold;
  margin-right: 16rpx;
}

.goods-original {
  font-size: 24rpx;
  color: #ccc;
  text-decoration: line-through;
}

.group-info-card {
  display: flex;
  align-items: center;
  background: #fff8f0;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #ff5000;
}

.group-tag {
  font-size: 24rpx;
  color: #fff;
  background: #ff5000;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.group-tip {
  font-size: 26rpx;
  color: #ff5000;
}

.count-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.count-label {
  font-size: 30rpx;
  color: #333;
}

.count-wrap {
  display: flex;
  align-items: center;
}

.count-btn {
  width: 56rpx;
  height: 56rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 36rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.count-btn.disabled {
  color: #ccc;
}

.count-value {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
}

.summary-card {
  background: #fff;
  padding: 30rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  color: #333;
}

.summary-row.total {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
  padding-top: 24rpx;
}

.summary-row.total .summary-value {
  color: #ff5000;
  font-size: 36rpx;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.bottom-price {
  flex: 1;
}

.bottom-label {
  font-size: 26rpx;
  color: #666;
}

.bottom-amount {
  font-size: 40rpx;
  color: #ff5000;
  font-weight: bold;
}

.submit-btn {
  width: 240rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #ff5000, #ff8533);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
