<view class="order-page">
  <view class="address-card" bindtap="onSelectAddress">
    <block wx:if="{{addressInfo}}">
      <view class="address-info">
        <view class="address-user">
          <text class="address-name">{{addressInfo.name}}</text>
          <text class="address-phone">{{addressInfo.phone}}</text>
        </view>
        <view class="address-detail">{{addressInfo.province}}{{addressInfo.city}}{{addressInfo.district}}{{addressInfo.detail}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="address-empty">
        <text>请选择收货地址</text>
      </view>
    </block>
    <text class="address-arrow">›</text>
  </view>

  <view class="goods-card" wx:if="{{goods}}">
    <view class="goods-image-wrap">
      <image class="goods-image" src="{{goods.image}}" mode="aspectFill"></image>
    </view>
    <view class="goods-info">
      <text class="goods-title">{{goods.title}}</text>
      <text class="goods-sku" wx:if="{{skuText}}">{{skuText}}</text>
      <view class="goods-price-row">
        <text class="goods-price">¥{{groupConfig.groupPrice}}</text>
        <text class="goods-original">¥{{groupConfig.originalPrice}}</text>
      </view>
    </view>
  </view>

  <!-- 拼团信息：参与他人拼团时展示团长与进度 -->
  <view class="group-info-card" wx:if="{{isGroup}}">
    <view class="group-tag">参与拼团</view>
    <view class="group-tip" wx:if="{{group}}">
      {{group.ownerNickname}} 发起的 {{group.requiredCount}} 人团，还差 {{group.requiredCount - group.currentCount}} 人成团
    </view>
    <view class="group-tip" wx:else>拼团信息加载中</view>
  </view>
  <view class="group-info-card" wx:else>
    <view class="group-tag new">发起拼团</view>
    <view class="group-tip">付款后即开团，分享给好友即可 {{groupConfig.groupSize}} 人成团</view>
  </view>

  <view class="count-card">
    <text class="count-label">购买数量</text>
    <view class="count-wrap">
      <view class="count-btn {{count <= 1 ? 'disabled' : ''}}" bindtap="onCountChange" data-type="minus">-</view>
      <text class="count-value">{{count}}</text>
      <view class="count-btn" bindtap="onCountChange" data-type="add">+</view>
    </view>
  </view>

  <view class="summary-card">
    <view class="summary-row">
      <text class="summary-label">商品金额</text>
      <text class="summary-value">¥{{goodsAmount}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">运费</text>
      <text class="summary-value">{{freight > 0 ? '¥' + freight : '免运费'}}</text>
    </view>
    <view class="summary-row total">
      <text class="summary-label">合计</text>
      <text class="summary-value">¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="pay-tip">提交后需完成支付，付款成功才计入拼团</view>

  <view class="bottom-bar">
    <view class="bottom-price">
      <text class="bottom-label">实付：</text>
      <text class="bottom-amount">¥{{totalPrice}}</text>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmitOrder">
      {{submitting ? '提交中…' : '提交订单'}}
    </view>
  </view>

  <pay-sheet id="paySheet" />
</view>
