.page {
  padding: 20rpx 24rpx 60rpx;
}

.group {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333333;
}

.row:last-child {
  border-bottom: none;
}

.arrow {
  color: #cccccc;
  font-size: 36rpx;
}

.tip {
  margin-top: 8rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #bbbbbb;
  line-height: 1.6;
}
