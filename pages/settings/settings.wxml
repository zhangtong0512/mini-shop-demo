<view class="page">
  <view class="group">
    <view class="row">
      <text>消息通知</text>
      <switch checked="{{notify}}" bindchange="onNotifyChange" color="#ff5000" />
    </view>
  </view>

  <view class="group">
    <view class="row" bindtap="onClearSearch"><text>清除搜索历史</text><text class="arrow">›</text></view>
    <view class="row" bindtap="onResetDemo"><text>重置演示数据</text><text class="arrow">›</text></view>
    <view class="row" bindtap="onAbout"><text>关于</text><text class="arrow">›</text></view>
  </view>

  <view class="tip">Demo 数据均保存在本地缓存中，重置后将恢复初始示例数据</view>
</view>
