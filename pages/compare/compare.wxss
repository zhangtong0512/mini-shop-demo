.compare-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 头部操作栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.compare-count {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.action-text {
  font-size: 26rpx;
  color: #ff5000;
}

.action-text.danger {
  color: #999;
}

/* 对比滚动区域 */
.compare-scroll {
  background: #fff;
  white-space: nowrap;
}

.compare-table {
  display: inline-block;
  min-width: 100%;
}

.compare-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-label {
  width: 160rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #fafafa;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* 商品行 */
.goods-row {
  background: #fff;
}

.goods-cell {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx;
  position: relative;
  display: inline-block;
  white-space: normal;
}

.goods-card {
  text-align: center;
}

.goods-emoji {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.goods-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 68rpx;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #ff4757;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 参数行 */
.param-cell {
  flex: 1;
  min-width: 200rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #333;
  display: inline-block;
  white-space: normal;
}

.param-value.price {
  color: #ff5000;
  font-weight: bold;
  font-size: 28rpx;
}

.param-value.number {
  color: #333;
}

.param-value.text {
  color: #666;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #ff5000;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

/* 对比分析 */
.analysis-section {
  background: #fff;
  margin-top: 20rpx;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.analysis-toggle {
  font-size: 24rpx;
  color: #999;
}

.analysis-content {
  padding: 20rpx 24rpx;
}

.analysis-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.analysis-dot {
  color: #ff5000;
  margin-right: 12rpx;
}

.best-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.best-label {
  background: #ff5000;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.best-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

/* 对比历史 */
.history-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-history {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
