.member-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 会员卡片 */
.member-card {
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.level-badge {
  display: flex;
  align-items: center;
}

.level-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.level-name {
  font-size: 32rpx;
  font-weight: bold;
}

.member-no {
  font-size: 22rpx;
  opacity: 0.8;
}

.card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.growth-info {
  text-align: center;
}

.growth-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.growth-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.growth-progress-wrap {
  flex: 1;
  margin: 0 30rpx;
}

.growth-progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.growth-progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.growth-progress-text {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  text-align: center;
}

.growth-progress-text .highlight {
  color: #fff;
  font-weight: bold;
  margin: 0 4rpx;
}

.discount-info {
  text-align: center;
}

.discount-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
}

.discount-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
  opacity: 0.9;
}

.arrow {
  font-size: 32rpx;
}

/* 积分签到 */
.points-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-balance {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5000;
}

.checkin-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  border-radius: 30rpx;
  color: #fff;
}

.checkin-btn.checked {
  background: #ccc;
}

.checkin-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.checkin-text {
  font-size: 24rpx;
}

/* 通用区块 */
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 权益网格 */
.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.benefit-item {
  text-align: center;
}

.benefit-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.benefit-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.benefit-status {
  display: block;
  font-size: 20rpx;
  color: #999;
}

.benefit-status.active {
  color: #ff5000;
}

/* 菜单列表 */
.menu-list {
  margin: 0 -24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-item .arrow {
  color: #ccc;
}
