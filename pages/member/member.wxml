<view class="member-page">
  <!-- 会员卡片 -->
  <view class="member-card" style="background: linear-gradient(135deg, {{memberInfo.levelColor}}, {{memberInfo.levelColor}}dd);">
    <view class="card-header">
      <view class="level-badge">
        <text class="level-icon">{{memberInfo.levelIcon}}</text>
        <text class="level-name">{{memberInfo.levelName}}</text>
      </view>
      <view class="member-no">{{memberInfo.memberNo}}</view>
    </view>
    <view class="card-body">
      <view class="growth-info">
        <text class="growth-value">{{memberInfo.growth}}</text>
        <text class="growth-label">成长值</text>
      </view>
      <view class="growth-progress-wrap">
        <view class="growth-progress-bar">
          <view class="growth-progress-fill" style="width: {{memberInfo.progress}}%;"></view>
        </view>
        <view class="growth-progress-text">
          <text>距{{memberInfo.nextLevel}}还需</text>
          <text class="highlight">{{memberInfo.growthToNext}}</text>
          <text>成长值</text>
        </view>
      </view>
      <view class="discount-info">
        <text class="discount-value">{{memberInfo.discount * 10}}折</text>
        <text class="discount-label">当前折扣</text>
      </view>
    </view>
    <view class="card-footer" bindtap="onLevelRuleTap">
      <text>查看等级规则</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 积分签到 -->
  <view class="section points-section">
    <view class="section-header">
      <text class="section-title">积分</text>
      <text class="points-balance">{{pointsBalance}}</text>
    </view>
    <view class="checkin-btn {{todayChecked ? 'checked' : ''}}" bindtap="onCheckinTap">
      <text class="checkin-icon">{{todayChecked ? '✓' : '+'}}</text>
      <text class="checkin-text">{{todayChecked ? '已签到' : '签到 +5积分'}}</text>
    </view>
  </view>

  <!-- 权益列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的权益</text>
    </view>
    <view class="benefits-grid">
      <view class="benefit-item">
        <text class="benefit-icon">{{memberInfo.benefits.freeShipping ? '🚚' : '📦'}}</text>
        <text class="benefit-name">免运费</text>
        <text class="benefit-status {{memberInfo.benefits.freeShipping ? 'active' : ''}}">
          {{memberInfo.benefits.freeShipping ? '已开通' : '未开通'}}
        </text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">🎫</text>
        <text class="benefit-name">专属券</text>
        <text class="benefit-status active">每月{{memberInfo.benefits.couponMonthly}}张</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">⭐</text>
        <text class="benefit-name">优先发货</text>
        <text class="benefit-status {{memberInfo.benefits.priorityShip ? 'active' : ''}}">
          {{memberInfo.benefits.priorityShip ? '已开通' : '未开通'}}
        </text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">🏷️</text>
        <text class="benefit-name">专属折扣</text>
        <text class="benefit-status active">{{memberInfo.discount * 10}}折</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section">
    <view class="menu-list">
      <view class="menu-item" bindtap="onCouponTap">
        <text class="menu-icon">🎫</text>
        <text class="menu-name">我的优惠券</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onFavoriteTap">
        <text class="menu-icon">❤️</text>
        <text class="menu-name">我的收藏</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGrowthDetailTap">
        <text class="menu-icon">📊</text>
        <text class="menu-name">成长值明细</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
