.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  background: #ffffff;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #ff5000;
  font-weight: 600;
  border-bottom-color: #ff5000;
}

.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 26rpx;
  color: #333333;
}

.order-status.wait-pay {
  color: #ff5000;
}

.order-status-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.order-remain {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #ff5000;
}

.order-items {
  padding: 20rpx 0;
}

.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 50rpx;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.g-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.g-title {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.g-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.g-price {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-left: 20rpx;
}

.order-foot {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #666666;
}

.price {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: 600;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.act-btn {
  padding: 12rpx 36rpx;
  border: 1rpx solid #dddddd;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333333;
}

.act-btn.primary {
  background: #ff5000;
  border-color: #ff5000;
  color: #ffffff;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 48rpx;
  padding: 16rpx 64rpx;
  color: #ffffff;
  background: #ff5000;
  border-radius: 40rpx;
  font-size: 28rpx;
}
