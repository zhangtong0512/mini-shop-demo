.page {
  padding-bottom: 20rpx;
}

/* 订单搜索框 */
.search-bar {
  padding: 20rpx 24rpx 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-ico {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #eee;
  color: #999;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
}

/* 胶囊式状态 tab */
.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f7f7f9;
  padding: 20rpx 24rpx 8rpx;
}

.tabs {
  white-space: nowrap;
}

.tab {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  box-shadow: 0 6rpx 14rpx rgba(255, 80, 0, 0.3);
  font-weight: 600;
}

.order-list {
  padding: 12rpx 24rpx 20rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.order-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status-col {
  display: flex;
  align-items: baseline;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-status.st-1 { color: #ff5000; }
.order-status.st-2 { color: #2f6bff; }
.order-status.st-3 { color: #8a4dff; }
.order-status.st-4 { color: #07c160; }
.order-status.st-5 { color: #999999; }
.order-status.st-6 { color: #ff8a00; }
.order-status.st-7 { color: #999999; }

.order-remain {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #ff5000;
  font-variant-numeric: tabular-nums;
}

.order-items {
  padding: 16rpx 0;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.thumb {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 46rpx;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.g-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.g-title {
  font-size: 27rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.g-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.g-price {
  font-size: 28rpx;
  color: #ff5000;
  font-weight: 600;
  margin-left: 16rpx;
}

.order-foot {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  color: #333333;
}

.price {
  color: #ff5000;
  font-size: 32rpx;
  font-weight: 600;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.act-btn {
  padding: 14rpx 44rpx;
  border: 1rpx solid #dddddd;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #333333;
  background: #ffffff;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.act-btn.primary {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(255, 80, 0, 0.28);
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 48rpx;
  padding: 16rpx 72rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-radius: 44rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
