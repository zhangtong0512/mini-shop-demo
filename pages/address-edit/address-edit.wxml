<view class="page">
  <view class="form-card">
    <view class="form-row">
      <text class="label">收货人</text>
      <input class="input" placeholder="请填写收货人姓名" value="{{form.name}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请填写手机号" value="{{form.phone}}" bindinput="onPhone" maxlength="11" />
    </view>
    <picker mode="region" value="{{form.region}}" bindchange="onRegion">
      <view class="form-row">
        <text class="label">所在地区</text>
        <view class="input region {{form.regionText ? '' : 'placeholder'}}">
          {{form.regionText || '请选择省 / 市 / 区'}}
        </view>
        <text class="arrow">›</text>
      </view>
    </picker>
    <view class="form-row textarea-row">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道、楼牌号等详细信息" value="{{form.detail}}" bindinput="onDetail" maxlength="60" auto-height />
    </view>
    <view class="form-row switch-row">
      <text class="label">设为默认地址</text>
      <switch checked="{{form.isDefault}}" bindchange="onDefault" color="#ff5000" />
    </view>
  </view>

  <view class="save-btn" bindtap="onSave">保存</view>
</view>
