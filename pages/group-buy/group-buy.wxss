.group-buy-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 头部Banner */
.header-banner {
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  padding: 40rpx 30rpx;
  text-align: center;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.banner-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 区块 */
.section {
  margin: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 商品横滑 */
.goods-scroll {
  white-space: nowrap;
}

.goods-list {
  display: inline-flex;
  gap: 20rpx;
}

.goods-card {
  width: 280rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-image {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-emoji {
  font-size: 100rpx;
}

.group-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #ff5000;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.group-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff5000;
}

.original-price {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.group-count {
  font-size: 20rpx;
  color: #999;
}

/* 拼团列表 */
.group-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.group-card {
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.group-card:last-child {
  border-bottom: none;
}

.group-header {
  display: flex;
  align-items: center;
}

.group-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.group-info {
  flex: 1;
}

.group-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.group-time {
  font-size: 24rpx;
  color: #ff5000;
}

.join-btn {
  background: #ff5000;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.group-members {
  display: flex;
  margin-top: 16rpx;
  padding-left: 96rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  margin-right: -12rpx;
  border: 4rpx solid #fff;
}

.member-avatar.empty {
  background: #ddd;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
