.page {
  padding: 0 0 40rpx;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ff5000;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.cancel {
  margin-left: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.section {
  padding: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.clear {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
}

.tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
}

.tag.hot {
  color: #ff5000;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}
