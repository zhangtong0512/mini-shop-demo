.page {
  padding: 0 0 40rpx;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(180deg, #ff6a00, #ff5000);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.cancel {
  margin-left: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.section {
  padding: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 20rpx;
  position: relative;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.section-head::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ff6a00, #ff3200);
}

.clear {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
}

.tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: opacity 0.2s ease;
}

.tag.hot {
  color: #ff5000;
  background: #fff2e8;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}
