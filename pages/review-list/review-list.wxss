.page {
  padding: 20rpx 24rpx 60rpx;
}

/* 评分汇总 */
.summary {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.s-avg {
  width: 220rpx;
  text-align: center;
  flex-shrink: 0;
}

.avg-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ff5000;
  line-height: 1;
}

.avg-star {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #ffb400;
  letter-spacing: 2rpx;
}

.avg-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.s-goods {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid #f0f0f0;
}

.thumb {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 44rpx;
}

.g-title {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

/* 评价列表 */
.review-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999999;
}
