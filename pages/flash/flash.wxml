<view class="page">
  <!-- 秒杀头部：渐变背景 + 倒计时 -->
  <view class="flash-header">
    <view class="flash-h-left">
      <view class="flash-h-title">⚡ 限时秒杀</view>
      <view class="flash-h-sub">超值好物 · 限时特价 · 手慢无</view>
    </view>
    <view class="flash-h-remain">
      <text class="flash-h-label">距结束</text>
      <text class="flash-h-time">{{remainText}}</text>
    </view>
  </view>

  <!-- 秒杀商品双列网格 -->
  <view class="flash-grid">
    <view
      class="flash-card card"
      wx:for="{{list}}"
      wx:key="id"
      hover-class="hv"
      bindtap="onTapGoods"
      data-id="{{item.id}}"
    >
      <view class="fc-thumb">
        <text class="fc-emoji">{{item.emoji}}</text>
        <image class="fc-img" src="{{item.galleryImages[0]}}" mode="aspectFill" lazy-load />
        <view class="fc-badge">限时</view>
      </view>
      <view class="fc-title clamp2">{{item.title}}</view>
      <view class="fc-price">
        <text class="fc-now">¥{{item.flashPrice}}</text>
        <text class="fc-origin">¥{{item.price}}</text>
      </view>
      <view class="fc-sold">已抢 {{item.flashSold}} 件 · 仅剩 {{item.flashStock}} 件</view>
    </view>
  </view>
</view>
