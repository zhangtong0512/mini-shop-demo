/* 限时秒杀 */
.page {
  padding-bottom: 40rpx;
}

.flash-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 30rpx;
  background: linear-gradient(160deg, #ff6a00, #ff3200);
  color: #fff;
}

.flash-h-left {
  display: flex;
  flex-direction: column;
}

.flash-h-title {
  font-size: 40rpx;
  font-weight: 700;
}

.flash-h-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.flash-h-remain {
  display: flex;
  align-items: center;
}

.flash-h-label {
  margin-right: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.flash-h-time {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 28rpx;
  font-weight: 700;
  font-family: monospace;
}

.flash-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx;
}

.flash-card {
  width: 48.5%;
  margin-bottom: 20rpx;
  padding: 16rpx;
  overflow: hidden;
}

.fc-thumb {
  position: relative;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-emoji {
  font-size: 120rpx;
}

.fc-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.fc-badge {
  position: absolute;
  top: 12rpx;
  left: 0;
  padding: 6rpx 16rpx;
  border-radius: 0 12rpx 12rpx 0;
  background: linear-gradient(90deg, #ff5000, #ff6a00);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.fc-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  height: 72rpx;
}

.fc-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.fc-now {
  color: #ff3200;
  font-size: 34rpx;
  font-weight: 700;
}

.fc-origin {
  margin-left: 10rpx;
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
}

.fc-sold {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
