.page {
  padding: 80rpx 48rpx 60rpx;
}

.result {
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 64rpx 0 56rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.icon {
  font-size: 120rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.amount {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 600;
  color: #ff5000;
}

.order-no {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.tips {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tips-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.btns {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border: 1rpx solid #dddddd;
  border-radius: 42rpx;
  font-size: 30rpx;
  color: #333333;
  background: #ffffff;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.btn.primary {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
}
