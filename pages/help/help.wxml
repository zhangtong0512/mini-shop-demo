<view class="page">
  <view class="faq">
    <view class="faq-item" wx:for="{{faqs}}" wx:key="q">
      <view class="faq-q" bindtap="onToggle" data-index="{{index}}">
        <text class="q-text">{{item.q}}</text>
        <text class="q-arrow {{activeIndex == index ? 'open' : ''}}">›</text>
      </view>
      <view class="faq-a" wx:if="{{activeIndex == index}}">{{item.a}}</view>
    </view>
  </view>

  <view class="contact" bindtap="onContact">
    <text class="contact-ico">💬</text>
    <text>联系客服</text>
    <text class="arrow">›</text>
  </view>
  <view class="tip">客服工作时间：9:00 - 21:00</view>
</view>
