.page {
  padding: 20rpx 24rpx 60rpx;
}

/* FAQ 手风琴 */
.faq {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.faq-item {
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 16rpx 0;
}

.q-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.q-arrow {
  color: #cccccc;
  font-size: 36rpx;
  transition: transform 0.2s;
}

.q-arrow.open {
  transform: rotate(90deg);
}

.faq-a {
  padding: 0 0 24rpx;
  font-size: 25rpx;
  color: #666666;
  line-height: 1.7;
}

/* 联系客服 */
.contact {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.contact-ico {
  margin-right: 20rpx;
  font-size: 36rpx;
}

.arrow {
  margin-left: auto;
  color: #cccccc;
  font-size: 36rpx;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
}
