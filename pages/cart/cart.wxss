.page {
  padding-bottom: 140rpx;
}

.list {
  padding: 20rpx 24rpx;
}

.item {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #cccccc;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.2s;
}

.checkbox.checked {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-color: transparent;
}

.thumb {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 60rpx;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  line-height: 1.4;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  color: #ff5000;
  font-size: 34rpx;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eeeeee;
  border-radius: 10rpx;
  overflow: hidden;
}

.step-btn {
  width: 56rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #fafafa;
  color: #333333;
  font-size: 28rpx;
}

.step-num {
  min-width: 68rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-left: 1rpx solid #eeeeee;
  border-right: 1rpx solid #eeeeee;
  font-size: 26rpx;
  font-weight: 600;
}

.remove {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  font-size: 24rpx;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 48rpx;
  padding: 16rpx 72rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-radius: 44rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.all-check {
  display: flex;
  align-items: center;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #cccccc;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  color: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.all-check.checked .check-box {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-color: transparent;
}

.all-label {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333333;
}

.total {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #333333;
}

.total-price {
  color: #ff5000;
  font-size: 40rpx;
  font-weight: 600;
}

.checkout-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 44rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.checkout-btn.disabled {
  background: #cccccc;
  box-shadow: none;
}
