/* 品牌渐变会员头部 */
.profile {
  position: relative;
  background: linear-gradient(160deg, #ff6a00, #ff3200);
  padding: 48rpx 32rpx 44rpx;
  overflow: hidden;
}

.profile-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.profile-decor.d1 {
  width: 300rpx;
  height: 300rpx;
  top: -140rpx;
  right: -70rpx;
}

.profile-decor.d2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -90rpx;
  left: -50rpx;
}

.profile-main {
  position: relative;
  display: flex;
  align-items: center;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.nickname {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
}

.user-id {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.profile-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
}

/* 头部统计行 */
.stats {
  position: relative;
  margin-top: 36rpx;
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

/* 我的订单 */
.order-entry {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.order-entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.order-entry-all {
  font-size: 24rpx;
  color: #999999;
}

.order-entry-row {
  margin-top: 28rpx;
  display: flex;
}

.entry-item {
  flex: 1;
  text-align: center;
}

.entry-ico {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.entry-ico.wait-pay {
  background: #fff2e8;
}

.entry-ico.wait-ship {
  background: #e8f1ff;
}

.entry-ico.wait-recv {
  background: #f3ebff;
}

.entry-ico.done {
  background: #e8f9f0;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ff5000;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
}

.entry-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #666666;
}

/* 功能菜单 */
.menu {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  height: 108rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333333;
}

.menu-item:last-child {
  border-bottom: none;
}

/* 分享按钮伪装成菜单行：布局由 .menu-item + 内联 style 保证与其它行一致，这里只需清掉 button 的 ::after 边框 */
.menu-share-btn::after {
  border: none;
}

.menu-ico {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.menu-ico.share {
  background: #fff2e8;
}

.menu-ico.address {
  background: #e8f1ff;
}

.menu-ico.coupon {
  background: #fff4e0;
}

.menu-ico.fav {
  background: #fff2e8;
}

.menu-ico.help {
  background: #f2f3f5;
}

.menu-ico.set {
  background: #e8f1ff;
}

.arrow {
  margin-left: auto;
  color: #cccccc;
  font-size: 36rpx;
}

.version {
  margin-top: 60rpx;
  text-align: center;
  color: #bbbbbb;
  font-size: 22rpx;
}
