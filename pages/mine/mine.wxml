<view class="page">
  <!-- 品牌渐变会员头部 -->
  <view class="profile">
    <view class="profile-decor d1"></view>
    <view class="profile-decor d2"></view>

    <view class="profile-main" hover-class="hv" bindtap="onProfileTap">
      <view class="avatar">
        <image
          wx:if="{{isLoggedIn && user.avatar && !avatarError}}"
          class="avatar-img"
          src="{{user.avatar}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
        <text wx:else>{{avatarText}}</text>
      </view>
      <view class="profile-info">
        <block wx:if="{{isLoggedIn}}">
          <view class="nickname">{{user.nickname}}</view>
          <view class="user-id">{{user.id}}</view>
        </block>
        <block wx:else>
          <view class="nickname">点击登录</view>
          <view class="user-id">登录后可同步订单与收藏</view>
        </block>
      </view>
      <view class="profile-arrow">编辑资料 ›</view>
    </view>

    <!-- 头部统计 -->
    <view class="stats">
      <view class="stat" hover-class="hv" bindtap="onFavoriteTap">
        <view class="stat-num">{{favCount}}</view>
        <view class="stat-label">收藏</view>
      </view>
      <view class="stat" hover-class="hv" bindtap="onCouponTap">
        <view class="stat-num">{{couponCount}}</view>
        <view class="stat-label">优惠券</view>
      </view>
      <view class="stat" hover-class="hv" bindtap="onCartTap">
        <view class="stat-num">{{cartCount}}</view>
        <view class="stat-label">购物车</view>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="order-entry">
    <view class="order-entry-head">
      <view class="order-entry-title">我的订单</view>
      <view class="order-entry-all" hover-class="hv" bindtap="onAllOrderTap">全部订单 ›</view>
    </view>
    <view class="order-entry-row">
      <view class="entry-item" hover-class="hv" bindtap="onOrderTap" data-tab="1">
        <view class="entry-ico wait-pay">💰<view class="badge" wx:if="{{orderCounts[0] > 0}}">{{orderCounts[0]}}</view></view>
        <view class="entry-name">待付款</view>
      </view>
      <view class="entry-item" hover-class="hv" bindtap="onOrderTap" data-tab="2">
        <view class="entry-ico wait-ship">📦<view class="badge" wx:if="{{orderCounts[1] > 0}}">{{orderCounts[1]}}</view></view>
        <view class="entry-name">待发货</view>
      </view>
      <view class="entry-item" hover-class="hv" bindtap="onOrderTap" data-tab="3">
        <view class="entry-ico wait-recv">🚚<view class="badge" wx:if="{{orderCounts[2] > 0}}">{{orderCounts[2]}}</view></view>
        <view class="entry-name">待收货</view>
      </view>
      <view class="entry-item" hover-class="hv" bindtap="onOrderTap" data-tab="4">
        <view class="entry-ico done">✅<view class="badge" wx:if="{{orderCounts[3] > 0}}">{{orderCounts[3]}}</view></view>
        <view class="entry-name">已完成</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu">
    <button
      class="menu-item menu-share-btn"
      open-type="share"
      hover-class="hv"
      style="display:flex;align-items:center;justify-content:flex-start;width:100%;height:108rpx;padding:0;margin:0;background:transparent;border:none;border-radius:0;text-align:left;line-height:normal;"
    >
      <view class="menu-ico share">📤</view>
      <text>分享给好友</text>
      <text class="arrow">›</text>
    </button>
    <view class="menu-item" hover-class="hv" bindtap="onAddressTap"><view class="menu-ico address">📍</view><text>收货地址</text><text class="arrow">›</text></view>
    <view class="menu-item" hover-class="hv" bindtap="onCouponTap"><view class="menu-ico coupon">🎫</view><text>优惠券</text><text class="arrow">›</text></view>
    <view class="menu-item" hover-class="hv" bindtap="onCheckinTap"><view class="menu-ico points">🎁</view><text>积分签到</text><text class="menu-value">{{pointsBalance}} 积分</text><text class="arrow">›</text></view>
    <view class="menu-item" hover-class="hv" bindtap="onFavoriteTap"><view class="menu-ico fav">⭐</view><text>我的收藏</text><text class="arrow">›</text></view>
    <view class="menu-item" hover-class="hv" bindtap="onHelpTap"><view class="menu-ico help">💬</view><text>帮助与客服</text><text class="arrow">›</text></view>
    <view class="menu-item" hover-class="hv" bindtap="onSettingsTap"><view class="menu-ico set">⚙️</view><text>设置</text><text class="arrow">›</text></view>
  </view>

  <view class="version">微信商城 Demo v1.0.0</view>
</view>
