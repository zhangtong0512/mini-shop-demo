.ar-page {
  min-height: 100vh;
  background: #000;
  position: relative;
}

/* 相机区域 */
.camera-area {
  width: 100%;
  height: 100vh;
  position: relative;
}

.camera {
  width: 100%;
  height: 100%;
}

.camera-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.model-area {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  width: 400rpx;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-area.flash {
  animation: flash 0.3s ease;
}

@keyframes flash {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

.model-placeholder {
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 40rpx;
}

.model-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 16rpx;
}

.model-text {
  color: #fff;
  font-size: 26rpx;
}

/* 热点标记 */
.hotspot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
}

.hotspot-dot {
  width: 24rpx;
  height: 24rpx;
  background: #ff4757;
  border-radius: 50%;
  border: 4rpx solid #fff;
  animation: hotspotPulse 1.5s infinite;
}

@keyframes hotspotPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.hotspot-label {
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  white-space: nowrap;
}

/* 摄像头占位 */
.camera-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.placeholder-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 16rpx;
}

.placeholder-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* 商品海报遮罩 */
.poster-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.poster-card {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.poster-image {
  width: 100%;
  height: 400rpx;
}

.poster-info {
  padding: 24rpx;
}

.poster-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.poster-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.poster-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  color: #ff5000;
  font-size: 28rpx;
}

.price-value {
  color: #ff5000;
  font-size: 40rpx;
  font-weight: bold;
}

.poster-close {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 底部工具栏 */
.toolbar {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 60rpx;
  padding: 20rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tool-icon.active {
  animation: heartBeat 0.3s ease;
}

@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

.tool-text {
  color: #fff;
  font-size: 22rpx;
}

.capture-btn {
  width: 120rpx;
  height: 120rpx;
}

.capture-ring {
  width: 100%;
  height: 100%;
  border: 8rpx solid #fff;
  border-radius: 50%;
  position: relative;
}

.capture-ring::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 80%;
  background: #fff;
  border-radius: 50%;
}

/* 购买按钮 */
.buy-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.1);
}

.buy-price {
  flex: 1;
}

.buy-price-label {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.buy-price-value {
  font-size: 36rpx;
  color: #ff5000;
  font-weight: bold;
}

.buy-btn {
  background: linear-gradient(135deg, #ff5000, #ff6a00);
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
}
