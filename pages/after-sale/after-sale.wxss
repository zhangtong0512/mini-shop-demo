.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

/* 商品信息 */
.goods-card {
  display: flex;
  align-items: center;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-emoji {
  font-size: 60rpx;
}

.g-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.g-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
}

.g-spec {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.g-amount {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

.g-amount .amount {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: 700;
}

/* 表单 */
.row-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 14rpx 32rpx;
  margin: 0 20rpx 20rpx 0;
  background: #f5f5f7;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333333;
  transition: all 0.15s ease;
}

.chip.active {
  background: #fff1e8;
  border-color: #ff6a00;
  color: #ff5000;
  font-weight: 600;
}

.textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  background: #f7f7f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.count-tip {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #bbbbbb;
}

.submit-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.submit-btn.disabled {
  background: #cccccc;
  box-shadow: none;
  opacity: 0.8;
}

/* 组件按压反馈 */
.hv {
  opacity: 0.82;
}
.hv-btn {
  opacity: 0.85;
  transform: scale(0.97);
}
