.group-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 状态头部 */
.status-header {
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  padding: 60rpx 30rpx;
  text-align: center;
  color: #fff;
}

.status-header.success {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
}

.status-header.fail {
  background: linear-gradient(135deg, #999, #bbb);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.status-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 商品卡片 */
.goods-card {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-emoji {
  font-size: 80rpx;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.group-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff5000;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 成员卡片 */
.members-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
}

.member-item.empty {
  opacity: 0.5;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.member-item.empty .member-avatar {
  background: #ddd;
}

.member-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.owner-tag {
  font-size: 20rpx;
  background: #ff5000;
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.member-time {
  font-size: 22rpx;
  color: #999;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-share,
.btn-join,
.btn-buy {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.btn-share {
  background: #fff;
  color: #ff5000;
  border: 2rpx solid #ff5000;
}

.btn-join {
  background: linear-gradient(135deg, #ff5000, #ff7b3a);
  color: #fff;
}

.btn-join.disabled {
  background: #ddd;
  color: #999;
}

.btn-buy {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
}
