<view class="page">
  <view class="goods-grid" wx:if="{{list.length > 0}}">
    <goods-card
      wx:for="{{list}}"
      wx:key="id"
      goods="{{item}}"
      removable
      bind:tapgoods="onTapGoods"
      bind:removegoods="onRemoveGoods"
    />
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">⭐</view>
    <view class="empty-text">还没有收藏的商品</view>
    <view class="empty-btn" bindtap="onGoShopping">去逛逛</view>
  </view>
</view>
