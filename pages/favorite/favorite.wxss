.page {
  padding: 20rpx 0 40rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 48rpx;
  padding: 16rpx 72rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-radius: 44rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
