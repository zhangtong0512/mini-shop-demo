.live-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 头部Banner */
.header-banner {
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  padding: 40rpx 30rpx;
  text-align: center;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.banner-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 分类标签 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff4757;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #ff4757;
  border-radius: 2rpx;
}

.live-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  background: #ff4757;
  border-radius: 50%;
  margin-left: 8rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 直播列表 */
.live-list {
  height: calc(100vh - 200rpx);
  padding: 20rpx;
}

.live-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.live-card.living {
  border: 2rpx solid #ff4757;
}

.live-cover {
  position: relative;
  height: 320rpx;
}

.live-cover image {
  width: 100%;
  height: 100%;
}

.live-status-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.live-status-badge.upcoming {
  background: #ffa502;
}

.live-status-badge.living {
  background: #ff4757;
  animation: pulse 1.5s infinite;
}

.live-status-badge.ended {
  background: #999;
}

.live-viewers {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
}

.viewers-icon {
  margin-right: 6rpx;
}

.live-info {
  padding: 20rpx;
}

.live-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.live-anchor {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.anchor-icon {
  margin-right: 8rpx;
}

.live-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.meta-icon {
  margin-right: 6rpx;
}

.live-action {
  padding: 0 20rpx 20rpx;
}

.action-btn {
  text-align: center;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.live-card.ended .action-btn {
  background: #ddd;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
