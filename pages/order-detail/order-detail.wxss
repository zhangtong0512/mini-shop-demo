.page {
  padding: 20rpx 24rpx 160rpx;
}

/* 状态头部 */
.status-head {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 80, 0, 0.28);
}

.status-icon {
  font-size: 64rpx;
  line-height: 1;
}

.status-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.status-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.status-remain {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 通用卡片 */
.card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 地址 */
.addr-card {
  display: flex;
  align-items: center;
}

.addr-ico {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.addr-info {
  flex: 1;
  min-width: 0;
}

.addr-line {
  display: flex;
  align-items: baseline;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.addr-phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

/* 商品 */
.goods-item {
  display: flex;
  margin-bottom: 20rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 50rpx;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.g-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.g-title {
  font-size: 27rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.g-spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.g-price {
  font-size: 28rpx;
  color: #ff5000;
  font-weight: 600;
}

.g-count {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
}

/* 金额 */
.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #f5f5f5;
}

.amount-row:last-child {
  border-bottom: none;
}

.amount-row.total {
  color: #333333;
  font-weight: 600;
}

.amount-row .free {
  color: #ff5000;
}

.amount-row .coupon {
  color: #ff5000;
}

/* 商品评价标签 */
.review-tag {
  flex-shrink: 0;
  align-self: flex-start;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid #ff5000;
  border-radius: 26rpx;
  font-size: 23rpx;
  color: #ff5000;
  transition: opacity 0.2s ease;
}

.review-tag.done {
  border-color: #dddddd;
  color: #999999;
  background: #f7f7f7;
}

/* 申请售后标签 */
.after-tag {
  flex-shrink: 0;
  align-self: flex-start;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid #999999;
  border-radius: 26rpx;
  font-size: 23rpx;
  color: #666666;
  transition: opacity 0.2s ease;
}

/* 售后记录 */
.after-card {
  margin-top: 20rpx;
}

.after-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 8rpx;
}

.after-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.after-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.after-goods {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: flex-start;
}

.after-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.after-info {
  flex: 1;
  min-width: 0;
}

.after-name {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
}

.after-spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.after-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.after-right {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
}

.after-status {
  font-size: 24rpx;
  font-weight: 600;
}

.after-status.st-pending {
  color: #ff6a00;
}

.after-status.st-refunded {
  color: #07c160;
}

.after-status.st-rejected {
  color: #999999;
}

.after-amount {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #ff5000;
  font-weight: 600;
}

.after-handle {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.after-btn {
  margin-left: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  font-size: 23rpx;
  border: 1rpx solid #dddddd;
  color: #666666;
  transition: opacity 0.2s ease;
}

.after-btn.agree {
  border-color: #ff5000;
  color: #ff5000;
}

.total-price {
  color: #ff5000;
  font-size: 34rpx;
  font-weight: 600;
}

/* 备注 */
.remark-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.remark-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 订单信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #999999;
}

.info-value {
  display: flex;
  align-items: center;
  color: #333333;
}

.info-no {
  font-size: 25rpx;
}

.copy-btn {
  margin-left: 16rpx;
  padding: 4rpx 20rpx;
  border: 1rpx solid #dddddd;
  border-radius: 22rpx;
  font-size: 22rpx;
  color: #ff5000;
}

/* 物流入口 */
.logistics-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
}

.lg-ico {
  margin-right: 20rpx;
  font-size: 40rpx;
}

.lg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.lg-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.lg-arrow {
  margin-left: auto;
  color: #cccccc;
  font-size: 36rpx;
}

/* 底部操作 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  background: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.act-btn {
  padding: 14rpx 44rpx;
  border: 1rpx solid #dddddd;
  border-radius: 36rpx;
  font-size: 27rpx;
  color: #333333;
  background: #ffffff;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.act-btn.primary {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(255, 80, 0, 0.28);
}
