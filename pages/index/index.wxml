<view class="page">
  <!-- 品牌渐变顶栏：搜索胶囊 + 扫一扫占位 -->
  <view class="header">
    <view class="header-inner">
      <view class="search-box" hover-class="hv" bindtap="onSearchTap">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索商品</text>
      </view>
      <view class="scan-btn" hover-class="hv" bindtap="onScanTap">
        <image class="scan-ico" src="/images/scan.png" mode="aspectFit" />
        <text class="scan-text">扫一扫</text>
      </view>
    </view>
  </view>

  <!-- 悬浮轮播卡片 -->
  <view class="banner-wrap">
    <swiper class="banner" autoplay circular interval="3000" bindchange="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-img" src="{{item.image}}" mode="aspectFill" bindtap="onBannerTap" data-banner="{{item}}" />
      </swiper-item>
    </swiper>
    <view class="banner-dots">
      <view
        class="banner-dot {{bannerCurrent == index ? 'active' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
        wx:for-index="index"
      ></view>
    </view>
  </view>

  <!-- 图标分类导航 + 排序栏（吸顶） -->
  <view class="category-sticky">
  <scroll-view class="category-nav" scroll-x>
    <view class="category-inner">
      <view
        class="category-item {{activeCategory == item.id ? 'active' : ''}}"
        hover-class="category-hv"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>
  </scroll-view>
  <sort-bar bind:sortchange="onSortchange" bind:pricechange="onPricechange" />
  </view>

  <!-- 限时秒杀 -->
  <view class="flash-wrap card" wx:if="{{flash.length}}">
    <view class="flash-head" hover-class="hv" bindtap="onFlashAll">
      <view class="flash-title">⚡ 限时秒杀</view>
      <view class="flash-remain">
        <text class="flash-remain-label">距结束</text>
        <text class="flash-remain-time">{{flashRemain}}</text>
      </view>
      <view class="flash-more">查看全部 ›</view>
    </view>
    <scroll-view class="flash-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="flash-inner">
        <view
          class="flash-item"
          wx:for="{{flash}}"
          wx:key="id"
          hover-class="hv"
          bindtap="onTapFlash"
          data-id="{{item.id}}"
        >
          <view class="fi-thumb">
            <text class="fi-emoji">{{item.emoji}}</text>
            <image class="fi-img" src="{{item.galleryImages[0]}}" mode="aspectFill" lazy-load />
            <view class="fi-badge">限时</view>
          </view>
          <view class="fi-name clamp2">{{item.title}}</view>
          <view class="fi-price">
            <text class="fi-now">¥{{item.flashPrice}}</text>
            <text class="fi-origin">¥{{item.price}}</text>
          </view>
          <view class="fi-progress">
            <view class="fi-bar">
              <view class="fi-bar-in" style="width: {{item.flashSold / (item.flashSold + item.flashStock) * 100}}%;"></view>
            </view>
            <text class="fi-sold">已抢 {{item.flashSold}} 件</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 拼团专区入口 -->
  <view class="group-entry card" hover-class="hv" bindtap="onGroupBuyTap">
    <view class="group-entry-icon">👥</view>
    <view class="group-entry-info">
      <view class="group-entry-title">拼团专区</view>
      <view class="group-entry-desc">人多更优惠，邀请好友一起买</view>
    </view>
    <view class="group-entry-btn">立即查看 ›</view>
  </view>

  <!-- 为你推荐 -->
  <view class="section-title">为你推荐</view>

  <view class="goods-grid">
    <goods-card
      wx:for="{{goodsList}}"
      wx:key="id"
      goods="{{item}}"
      bind:tapgoods="onTapGoods"
    />
  </view>

  <view class="empty" wx:if="{{goodsList.length == 0}}">
    <view class="empty-icon">🛍️</view>
    <view class="empty-text">没有找到相关商品</view>
  </view>
</view>
