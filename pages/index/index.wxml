<view class="page">
  <!-- 品牌渐变顶栏：搜索胶囊 + 扫一扫占位 -->
  <view class="header">
    <view class="header-inner">
      <view class="search-box" hover-class="hv" bindtap="onSearchTap">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索商品</text>
      </view>
      <view class="scan-btn" hover-class="hv" bindtap="onScanTap">
        <image class="scan-ico" src="/images/scan.png" mode="aspectFit" />
        <text class="scan-text">扫一扫</text>
      </view>
    </view>
  </view>

  <!-- 悬浮轮播卡片 -->
  <view class="banner-wrap">
    <swiper class="banner" autoplay circular interval="3000" bindchange="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-img" src="{{item.image}}" mode="aspectFill" bindtap="onBannerTap" data-banner="{{item}}" />
      </swiper-item>
    </swiper>
    <view class="banner-dots">
      <view
        class="banner-dot {{bannerCurrent == index ? 'active' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
        wx:for-index="index"
      ></view>
    </view>
  </view>

  <!-- 限时秒杀 -->
  <view class="flash-section" wx:if="{{flashList.length > 0}}">
    <view class="flash-head">
      <text class="flash-title">⚡ 限时秒杀</text>
      <text class="flash-tip">手慢无 · 每日限量</text>
    </view>
    <scroll-view class="flash-scroll" scroll-x>
      <view class="flash-inner">
        <view class="flash-item" hover-class="hv" wx:for="{{flashList}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapFlash">
          <view class="flash-thumb"><text class="flash-emoji">{{item.emoji}}</text></view>
          <view class="flash-name">{{item.title}}</view>
          <view class="flash-price">
            <text class="flash-now">¥{{item.flashPrice}}</text>
            <text class="flash-old">¥{{item.price}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 图标分类导航 + 排序栏（吸顶） -->
  <view class="category-sticky">
  <scroll-view class="category-nav" scroll-x>
    <view class="category-inner">
      <view
        class="category-item {{activeCategory == item.id ? 'active' : ''}}"
        hover-class="category-hv"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>
  </scroll-view>
  <sort-bar bind:sortchange="onSortchange" bind:pricechange="onPricechange" />
  </view>

  <!-- 猜你喜欢 -->
  <view class="section-title">猜你喜欢</view>

  <view class="goods-grid">
    <goods-card
      wx:for="{{goodsList}}"
      wx:key="id"
      goods="{{item}}"
      bind:tapgoods="onTapGoods"
    />
  </view>

  <view class="empty" wx:if="{{goodsList.length == 0}}">
    <view class="empty-icon">🛍️</view>
    <view class="empty-text">没有找到相关商品</view>
  </view>
</view>
