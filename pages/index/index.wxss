.page {
  padding-bottom: 40rpx;
}

/* 品牌渐变顶栏 */
.header {
  background: linear-gradient(180deg, #ff6a00, #ff5000);
  padding: 16rpx 24rpx 28rpx;
}

.header-inner {
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #999999;
}

.scan-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
  color: #ffffff;
}

.scan-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.scan-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.95;
}

/* 悬浮轮播卡片 */
.banner-wrap {
  position: relative;
  padding: 20rpx 24rpx 0;
}

.banner {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* 自定义指示点：激活项变长条高亮 */
.banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  display: flex;
  justify-content: center;
  z-index: 2;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  margin: 0 8rpx;
  transition: all 0.3s;
}

.banner-dot.active {
  width: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

/* 限时秒杀 */
.flash-section {
  margin: 24rpx 0 0;
  padding: 24rpx 0 8rpx;
  background: linear-gradient(180deg, #fff3e9, #ffffff);
}

.flash-head {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.flash-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff5000;
}

.flash-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #ff9a62;
}

.flash-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.flash-inner {
  display: inline-flex;
  padding: 0 16rpx;
}

.flash-item {
  width: 200rpx;
  margin: 0 12rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.flash-thumb {
  height: 120rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flash-emoji {
  font-size: 56rpx;
}

.flash-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.flash-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.flash-now {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: 700;
}

.flash-old {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #bbbbbb;
  text-decoration: line-through;
}

.hv {
  opacity: 0.82;
}

/* 图标分类导航（吸顶容器） */
.category-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f7f7f9;
}

.category-nav {
  white-space: nowrap;
  padding: 24rpx 12rpx 8rpx;
}

.category-inner {
  display: inline-flex;
  padding: 0 12rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
  width: 96rpx;
}

.category-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: all 0.2s;
}

.category-item.active .category-icon {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  box-shadow: 0 6rpx 16rpx rgba(255, 80, 0, 0.35);
}

.category-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #666666;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: #ff5000;
  font-weight: 600;
}

.category-hv {
  opacity: 0.8;
}

/* 商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}

/* 限时秒杀 */
.flash-wrap {
  margin: 20rpx 20rpx 8rpx;
  padding: 24rpx 24rpx 20rpx;
  overflow: hidden;
}

.flash-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.flash-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff3200;
}

.flash-remain {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.flash-remain-label {
  font-size: 22rpx;
  color: #999;
}

.flash-remain-time {
  margin-left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #fff1ec;
  color: #ff5000;
  font-size: 24rpx;
  font-weight: 700;
  font-family: monospace;
}

.flash-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.flash-inner {
  display: inline-flex;
}

.flash-item {
  width: 220rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.flash-item:last-child {
  margin-right: 0;
}

.fi-thumb {
  position: relative;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fi-emoji {
  font-size: 100rpx;
}

.fi-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.fi-badge {
  position: absolute;
  top: 10rpx;
  left: 0;
  padding: 4rpx 14rpx;
  border-radius: 0 10rpx 10rpx 0;
  background: linear-gradient(90deg, #ff5000, #ff6a00);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.fi-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  height: 66rpx;
}

.fi-price {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.fi-now {
  color: #ff3200;
  font-size: 32rpx;
  font-weight: 700;
}

.fi-origin {
  margin-left: 8rpx;
  color: #bbb;
  font-size: 22rpx;
  text-decoration: line-through;
}

.fi-progress {
  margin-top: 10rpx;
}

.fi-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: #f3f3f3;
  overflow: hidden;
}

.fi-bar-in {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #ff6a00, #ff3200);
}

.fi-sold {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}

/* 拼团专区入口 */
.group-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 20rpx 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f3e8ff, #ede0ff);
  border-radius: 20rpx;
}

.group-entry-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.group-entry-info {
  flex: 1;
}

.group-entry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #9C27B0;
  margin-bottom: 8rpx;
}

.group-entry-desc {
  font-size: 24rpx;
  color: #666;
}

.group-entry-btn {
  font-size: 26rpx;
  color: #9C27B0;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  padding: 20rpx 20rpx 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999999;
}

.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 直播入口 */
.live-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 20rpx 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffe0e3, #ffd0d6);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.live-pulse {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #ff4757;
  border-radius: 50%;
  animation: livePulse 1.5s infinite;
}

@keyframes livePulse {
  0%, 100% { 
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.7);
  }
  50% { 
    opacity: 0.8;
    box-shadow: 0 0 0 10rpx rgba(255, 71, 87, 0);
  }
}

.live-entry-icon {
  font-size: 48rpx;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.live-entry-info {
  flex: 1;
}

.live-entry-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff4757;
  margin-bottom: 4rpx;
}

.live-entry-desc {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.live-entry-btn {
  font-size: 24rpx;
  color: #ff4757;
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
}
