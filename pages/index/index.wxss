.page {
  padding-bottom: 40rpx;
}

/* 品牌渐变顶栏 */
.header {
  background: linear-gradient(180deg, #ff6a00, #ff5000);
  padding: 16rpx 24rpx 28rpx;
}

.header-inner {
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #999999;
}

.scan-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
  color: #ffffff;
}

.scan-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.scan-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.95;
}

/* 悬浮轮播卡片 */
.banner-wrap {
  position: relative;
  padding: 20rpx 24rpx 0;
}

.banner {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* 自定义指示点：激活项变长条高亮 */
.banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  display: flex;
  justify-content: center;
  z-index: 2;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  margin: 0 8rpx;
  transition: all 0.3s;
}

.banner-dot.active {
  width: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

/* 限时秒杀 */
.flash-section {
  margin: 24rpx 0 0;
  padding: 24rpx 0 8rpx;
  background: linear-gradient(180deg, #fff3e9, #ffffff);
}

.flash-head {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.flash-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff5000;
}

.flash-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #ff9a62;
}

.flash-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.flash-inner {
  display: inline-flex;
  padding: 0 16rpx;
}

.flash-item {
  width: 200rpx;
  margin: 0 12rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.flash-thumb {
  height: 120rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flash-emoji {
  font-size: 56rpx;
}

.flash-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.flash-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.flash-now {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: 700;
}

.flash-old {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #bbbbbb;
  text-decoration: line-through;
}

.hv {
  opacity: 0.82;
}

/* 图标分类导航（吸顶容器） */
.category-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f7f7f9;
}

.category-nav {
  white-space: nowrap;
  padding: 24rpx 12rpx 8rpx;
}

.category-inner {
  display: inline-flex;
  padding: 0 12rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
  width: 96rpx;
}

.category-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: all 0.2s;
}

.category-item.active .category-icon {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  box-shadow: 0 6rpx 16rpx rgba(255, 80, 0, 0.35);
}

.category-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #666666;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: #ff5000;
  font-weight: 600;
}

.category-hv {
  opacity: 0.8;
}

/* 商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}
