.page {
  padding-bottom: 40rpx;
}

.search-bar {
  padding: 16rpx 24rpx;
  background: #ff5000;
}

.search-box {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.banner {
  height: 300rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.category-nav {
  white-space: nowrap;
  background: #ffffff;
  padding: 20rpx 0;
}

.category-item {
  display: inline-block;
  margin: 0 20rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 4rpx solid transparent;
}

.category-item.active {
  color: #ff5000;
  font-weight: 600;
  border-bottom-color: #ff5000;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.goods-grid goods-card {
  width: 48.5%;
  margin-bottom: 20rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}
