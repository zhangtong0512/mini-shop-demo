.page {
  padding-bottom: 140rpx;
}

/* 图集：顶部通栏、底部圆角 */
.gallery {
  position: relative;
  width: 100%;
  height: 700rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  overflow: hidden;
  border-radius: 0 0 24rpx 24rpx;
}

.gallery-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 240rpx;
}

.gallery-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.gallery-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 自定义指示点：激活项变长条高亮 */
.gallery-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  justify-content: center;
  z-index: 2;
}

.gallery-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  margin: 0 8rpx;
  transition: all 0.3s;
}

.gallery-dot.active {
  width: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

/* 信息卡 */
.info {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price {
  color: #ff5000;
  font-weight: 600;
}

.price .symbol {
  font-size: 28rpx;
}

.price .num {
  font-size: 56rpx;
}

.price .origin {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #bbbbbb;
  font-weight: 400;
  text-decoration: line-through;
}

.sales {
  font-size: 24rpx;
  color: #999999;
}

/* 限时秒杀角标与倒计时 */
.flash-badge {
  display: inline-block;
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  vertical-align: middle;
}

.flash-sales {
  color: #ff5000;
}

.title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* 规格选择行 */
.spec-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.spec-row-label {
  font-size: 26rpx;
  color: #999999;
}

.spec-row-value {
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.spec-row-arrow {
  color: #cccccc;
  font-size: 32rpx;
}

.meta {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  padding: 8rpx 20rpx;
  background: #fff5f0;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #e05e17;
}

/* 数量选择 */
.qty {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.qty-label {
  font-size: 28rpx;
  color: #333333;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eeeeee;
  border-radius: 12rpx;
  overflow: hidden;
}

.step-btn {
  width: 64rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #fafafa;
  color: #333333;
  font-size: 32rpx;
}

.step-btn.disabled {
  color: #cccccc;
}

.step-num {
  min-width: 80rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-left: 1rpx solid #eeeeee;
  border-right: 1rpx solid #eeeeee;
  font-size: 28rpx;
  font-weight: 600;
}

/* 服务承诺 */
.service {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.service-item {
  font-size: 24rpx;
  color: #666666;
}

/* 商品评价预览 */
.review-block {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: opacity 0.2s ease;
}

.review-head {
  display: flex;
  align-items: baseline;
  padding: 0 28rpx 8rpx;
}

.review-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.review-summary {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ffb400;
  letter-spacing: 1rpx;
}

.review-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.review-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #999999;
}

.review-preview {
  border-bottom: 1rpx solid #f5f5f5;
}

.review-preview:last-child {
  border-bottom: none;
}

/* 商品图文详情 */
.detail-block {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.detail-title {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.detail-line {
  width: 64rpx;
  height: 2rpx;
  background: #e5e5e5;
  margin: 0 20rpx;
}

.detail-intro {
  padding: 0 28rpx;
}

.detail-para {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.detail-imgs {
  margin-top: 8rpx;
  width: 100%;
}

.detail-img {
  display: block;
  width: 100%;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.footer-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
}

.footer-icon .icon {
  font-size: 36rpx;
  line-height: 1.2;
  color: #666666;
}

.footer-icon.fav-on .icon {
  color: #ff5000;
}

.ft-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #666666;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
}

.footer-btn.add {
  margin-left: 16rpx;
  background: linear-gradient(90deg, #ffa940, #ff7800);
  border-radius: 40rpx 0 0 40rpx;
}

.footer-btn.buy {
  background: linear-gradient(90deg, #ff5500, #ff3200);
  border-radius: 0 40rpx 40rpx 0;
}
