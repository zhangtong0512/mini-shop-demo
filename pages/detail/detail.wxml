<view class="page" wx:if="{{goods}}">
  <view class="gallery">
    <!-- 图片加载失败时的 emoji 兜底（图片盖在上层） -->
    <text class="gallery-emoji">{{goods.emoji}}</text>
    <swiper
      class="gallery-swiper"
      circular
      autoplay
      interval="4000"
      duration="400"
      bindchange="onGalleryChange"
    >
      <swiper-item wx:for="{{goods.galleryImages}}" wx:key="*this">
        <image
          class="gallery-img"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onGalleryTap"
          data-src="{{item}}"
        />
      </swiper-item>
    </swiper>
    <view class="gallery-dots">
      <view
        class="gallery-dot {{galleryCurrent == index ? 'active' : ''}}"
        wx:for="{{goods.galleryImages}}"
        wx:key="*this"
        wx:for-index="index"
      ></view>
    </view>
  </view>

  <view class="info">
    <view class="price-row">
      <view class="price">
        <text class="symbol">¥</text>
        <text class="num">{{isGroupMode ? groupPrice : (isFlash ? goods.flashPrice : skuPrice)}}</text>
        <text class="origin">¥{{goods.originalPrice}}</text>
        <view class="flash-badge" wx:if="{{isFlash}}">限时</view>
        <view class="group-badge" wx:if="{{isGroupMode}}">拼团</view>
      </view>
      <view class="sales" wx:if="{{!isFlash && !isGroupMode}}">已售 {{goods.sales}} 件</view>
      <view class="sales flash-sales" wx:elif="{{isFlash}}">限时价 · 距结束 {{flashRemain}}</view>
      <view class="sales group-sales" wx:elif="{{isGroupMode}}">{{groupConfig.groupSize}}人拼团 · 享更优价格</view>
    </view>
    <view class="title">{{goods.title}}</view>
    <view class="desc">{{goods.desc}}</view>
    <view class="spec-row" wx:if="{{hasSpec}}" hover-class="hv" bindtap="onSpecTap">
      <text class="spec-row-label">规格</text>
      <text class="spec-row-value">已选：{{skuText}}</text>
      <text class="spec-row-arrow">›</text>
    </view>
    <view class="meta">
      <text class="meta-item">📦 库存 {{skuStock}} 件</text>
      <text class="meta-item">🚚 48 小时内发货</text>
    </view>
  </view>

  <view class="qty">
    <view class="qty-label">购买数量</view>
    <view class="stepper">
      <view class="step-btn {{count <= 1 ? 'disabled' : ''}}" hover-class="hv" bindtap="onMinus">−</view>
      <view class="step-num">{{count}}</view>
      <view class="step-btn {{count >= countMax ? 'disabled' : ''}}" hover-class="hv" bindtap="onPlus">+</view>
    </view>
  </view>

  <view class="service">
    <view class="service-item">🛡️ 正品保障</view>
    <view class="service-item">📦 满99包邮</view>
    <view class="service-item">↩️ 7天无理由退货</view>
  </view>

  <!-- AR预览入口 -->
  <view class="ar-entry" wx:if="{{hasAr}}" hover-class="hv" bindtap="onArTap">
    <view class="ar-icon">📱</view>
    <view class="ar-info">
      <text class="ar-title">AR试穿/试用</text>
      <text class="ar-desc">支持摄像头实时预览</text>
    </view>
    <view class="ar-btn">立即体验 ›</view>
  </view>

  <!-- 加入对比 -->
  <view class="compare-entry {{isCompare ? 'active' : ''}}" hover-class="hv" bindtap="onCompareTap">
    <text class="compare-icon">{{isCompare ? '✓' : '📊'}}</text>
    <text class="compare-text">{{isCompare ? '已加入对比' : '加入对比'}}</text>
  </view>

  <!-- 商品评价预览 -->
  <view class="review-block" wx:if="{{reviewCount > 0}}" hover-class="hv" bindtap="onReviewTap">
    <view class="review-head">
      <text class="review-title">商品评价</text>
      <text class="review-summary">{{reviewStars}} {{reviewAvg}} 分</text>
      <text class="review-count">{{reviewCount}} 条</text>
      <text class="review-more">查看全部 ›</text>
    </view>
    <view class="review-preview" wx:for="{{reviewPreview}}" wx:key="id" wx:for-item="rv">
      <review-card review="{{rv}}" />
    </view>
  </view>

  <!-- 商品图文详情 -->
  <view class="detail-block" wx:if="{{goods.detailImages.length > 0 || goods.detail.length > 0}}">
    <view class="detail-title">
      <view class="detail-line"></view>
      <text>商品详情</text>
      <view class="detail-line"></view>
    </view>

    <view class="detail-intro" wx:if="{{goods.detail.length > 0}}">
      <view class="detail-para" wx:for="{{goods.detail}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="detail-imgs" wx:if="{{goods.detailImages.length > 0}}">
      <image
        class="detail-img"
        wx:for="{{goods.detailImages}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        lazy-load
        bindtap="onPreview"
        data-src="{{item}}"
      />
    </view>
  </view>

  <!-- 拼团入口 -->
  <view class="group-section" wx:if="{{groupConfig && !isGroupMode}}">
    <view class="group-header">
      <text class="group-title">拼团更优惠</text>
      <text class="group-price">¥{{groupConfig.groupPrice}}</text>
    </view>
    <view class="joinable-groups" wx:if="{{joinableGroups.length > 0}}">
      <view class="joinable-title">正在拼团，快来参与</view>
      <scroll-view scroll-x class="joinable-list">
        <view 
          class="joinable-item" 
          wx:for="{{joinableGroups}}" 
          wx:key="id"
          bindtap="onJoinableGroupTap"
          data-id="{{item.id}}"
        >
          <view class="joinable-avatar">
            <text>{{item.ownerNickname[0]}}</text>
          </view>
          <view class="joinable-info">
            <text class="joinable-name">{{item.ownerNickname}}</text>
            <text class="joinable-remain">还差{{item.requiredCount - item.currentCount}}人</text>
          </view>
          <view class="joinable-btn">去拼团</view>
        </view>
      </scroll-view>
    </view>
    <view class="create-group-btn" bindtap="onCreateGroup" wx:if="{{canCreateGroup}}">
      <text>发起拼团</text>
    </view>
  </view>

  <view class="footer">
    <view class="footer-icon" bindtap="onGoHome"><text class="icon">🏠</text><text class="ft-text">首页</text></view>
    <view class="footer-icon" bindtap="onGoCart"><text class="icon">🛒</text><text class="ft-text">购物车</text></view>
    <view class="footer-icon {{isFav ? 'fav-on' : ''}}" bindtap="onToggleFav"><text class="icon">{{isFav ? '♥' : '♡'}}</text><text class="ft-text">{{isFav ? '已收藏' : '收藏'}}</text></view>
    <view class="footer-btn add" bindtap="onAddCart" wx:if="{{!isGroupMode}}">加入购物车</view>
    <view class="footer-btn buy" bindtap="onBuyNow">{{isGroupMode ? '拼团购买' : '立即购买'}}</view>
  </view>

  <sku-sheet id="skuSheet" />
</view>
