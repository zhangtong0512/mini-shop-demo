.store-select-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.store-list {
  height: calc(100vh - 140rpx);
  padding: 20rpx;
}

.store-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.store-item.selected {
  border-color: #ff5000;
  background: #fff5f0;
}

.store-main {
  flex: 1;
}

.store-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.store-distance {
  font-size: 24rpx;
  color: #ff5000;
}

.store-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-item.selected .store-check {
  background: #ff5000;
  border-color: #ff5000;
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
}
