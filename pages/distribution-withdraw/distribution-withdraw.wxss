.withdraw-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.balance-card {
  background: linear-gradient(135deg, #ff5000, #ff8533);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.balance-value {
  font-size: 72rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.balance-frozen {
  font-size: 24rpx;
  opacity: 0.8;
}

.form-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  width: 160rpx;
}

.form-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
}

.form-prefix {
  font-size: 36rpx;
  color: #ff5000;
  margin-right: 10rpx;
}

.form-input {
  flex: 1;
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

.quick-amounts {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bank-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.bank-list {
  margin-top: 16rpx;
}

.bank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.bank-item.selected {
  border-color: #ff5000;
  background: #fff5f0;
}

.bank-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.bank-info {
  flex: 1;
}

.bank-name {
  display: block;
  font-size: 30rpx;
  color: #333;
}

.bank-card {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.bank-check {
  width: 40rpx;
  height: 40rpx;
  background: #ff5000;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.submit-btn {
  margin: 40rpx 30rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ff5000, #ff8533);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.record-list {
  margin-top: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-bank {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.record-time {
  display: block;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.record-right {
  text-align: right;
}

.record-amount {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.record-status {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.status-0 {
  color: #ff9500;
}

.status-1 {
  color: #34c759;
}

.status-2 {
  color: #ff3b30;
}
