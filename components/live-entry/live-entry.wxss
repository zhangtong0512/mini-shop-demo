.live-entry {
  position: relative;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
}

.live-entry.normal {
  height: 320rpx;
}

.live-entry.small {
  height: 200rpx;
}

.live-entry.mini {
  height: 120rpx;
}

.live-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  z-index: 10;
}

.live-badge.live {
  background: #ff3b30;
}

.badge-text {
  font-size: inherit;
}

.live-cover {
  width: 100%;
  height: 100%;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.live-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
}

.placeholder-icon {
  font-size: 80rpx;
}

.live-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
}

.live-title {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.live-meta {
  display: flex;
  align-items: center;
}

.anchor-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 16rpx;
}

.viewer-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.live-pulse {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff3b30;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.5);
    opacity: 0.5;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
