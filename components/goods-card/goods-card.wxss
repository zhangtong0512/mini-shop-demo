:host {
  display: block;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

/* 按压反馈（hover-class） */
.card-hv {
  transform: scale(0.97);
  opacity: 0.94;
}

.card-img {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
}

.card-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 90rpx;
  line-height: 1;
}

.card-img-src {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 左上角标签角标 */
.card-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.3;
  border-radius: 22rpx;
  z-index: 3;
  box-shadow: 0 4rpx 10rpx rgba(255, 80, 0, 0.35);
}

.card-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  border-radius: 50%;
  font-size: 26rpx;
  z-index: 3;
}

.card-body {
  padding: 16rpx 20rpx 22rpx;
}

.card-title {
  font-size: 28rpx;
  line-height: 1.4;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 78rpx;
}

.card-sales {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.card-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  color: #ff5000;
  font-weight: 600;
}

.card-price .symbol {
  font-size: 24rpx;
}

.card-price .num {
  font-size: 36rpx;
}

.card-price .origin {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #bbbbbb;
  font-weight: 400;
  text-decoration: line-through;
}
