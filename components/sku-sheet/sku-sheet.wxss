/* 商品规格选择底部弹层 */
.sku-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  animation: mask-in 0.25s ease;
}
.mask.out {
  animation: mask-out 0.2s ease forwards;
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 36rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: sheet-in 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 80vh;
  overflow-y: auto;
}
.sheet.out {
  animation: sheet-out 0.2s ease forwards;
}

.handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e5e5;
  margin: 0 auto 28rpx;
}

.goods-bar {
  display: flex;
  align-items: center;
}
.g-thumb {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.g-emoji {
  font-size: 60rpx;
}
.g-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.g-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.g-price {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}
.g-price .symbol {
  color: #ff5000;
  font-size: 28rpx;
  font-weight: 600;
}
.g-price .num {
  color: #ff5000;
  font-size: 44rpx;
  font-weight: 700;
}
.g-stock {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999999;
}
.g-stock.out {
  color: #ff5000;
}
.close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  flex-shrink: 0;
}

.spec-group {
  margin-top: 32rpx;
}
.spec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.spec-vals {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}
.spec-val {
  padding: 14rpx 36rpx;
  margin: 0 20rpx 20rpx 0;
  background: #f5f5f7;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333333;
  transition: all 0.15s ease;
}
.spec-val.active {
  background: #fff1e8;
  border-color: #ff6a00;
  color: #ff5000;
  font-weight: 600;
}

.count-bar {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.count-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eeeeee;
  border-radius: 10rpx;
  overflow: hidden;
}
.step-btn {
  width: 56rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #fafafa;
  color: #333333;
  font-size: 28rpx;
}
.step-num {
  min-width: 68rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-left: 1rpx solid #eeeeee;
  border-right: 1rpx solid #eeeeee;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-primary {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.3);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.btn-primary.disabled {
  background: #cccccc;
  box-shadow: none;
  opacity: 0.8;
}

.btn-cancel {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #666666;
  font-size: 30rpx;
  transition: opacity 0.2s ease;
}

/* 组件样式隔离：内部复刻全局按压反馈 */
.hv {
  opacity: 0.82;
}
.hv-btn {
  opacity: 0.85;
  transform: scale(0.97);
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
