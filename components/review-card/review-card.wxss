.review {
  padding: 24rpx 28rpx;
}

.r-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fde2d9, #fff0ea);
  color: #ff5000;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.r-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.r-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.r-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
}

.r-stars {
  font-size: 24rpx;
  color: #ffb400;
  letter-spacing: 2rpx;
}

.r-time {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

.r-content {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #333333;
  line-height: 1.6;
}

.r-images {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.r-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}
