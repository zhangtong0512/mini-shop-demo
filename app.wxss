/* 全局样式与设计规范
 * 品牌主色 #ff5000，品牌渐变 linear-gradient(135deg, #ff6a00, #ff3200)
 * 中性色 #333 / #666 / #999 / #ccc；页面背景 #f7f7f9
 */
page {
  background-color: #f7f7f9;
  font-size: 28rpx;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: none;
}

/* 通用两行省略 */
.clamp2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 白卡基类：圆角 + 轻阴影 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 区块标题：左橙竖条 + 文字 */
.section-title {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  background: linear-gradient(180deg, #ff6a00, #ff3200);
}

/* 统一空态：大 emoji + 文案 + 主色胶囊按钮 */
.empty {
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  line-height: 1;
}

.empty-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 48rpx;
  padding: 16rpx 72rpx;
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.28);
}

/* 主色渐变胶囊按钮 */
.btn-primary {
  background: linear-gradient(135deg, #ff6a00, #ff3200);
  color: #ffffff;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.25);
}

/* 按压反馈（配合 hover-class 使用，如 hover-class="hv" / "hv-btn"） */
.hv {
  transition: opacity 0.2s ease, transform 0.2s ease;
  opacity: 0.82;
}

.hv-btn {
  transition: opacity 0.2s ease, transform 0.2s ease;
  opacity: 0.85;
  transform: scale(0.97);
}

/* 安全区底部留白 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
